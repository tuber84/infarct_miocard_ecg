{
  "name": "ecg-education",
  "private": true,
  "version": "1.0.0",
  "description": "КардиоАтлас ЭКГ — 3D-локализатор ИМ, ЭКГ-движок и симулятор КАГ",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "check:core": "tsc -p tsconfig.core.json",
    "test:core": "npm run check:core && node --test scripts/test-core.cjs",
    "test:training": "node --test scripts/test-training.cjs",
    "test:ecg": "node --test scripts/test-ecg.cjs",
    "test:clinical": "node --test scripts/test-clinical.cjs",
    "test:heart": "node --test scripts/test-heart-model.cjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win portable",
    "android:sync": "node scripts/android.cjs sync",
    "check:android": "node scripts/check-android.cjs",
    "android:apk": "node scripts/android.cjs apk",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "ru.cardioatlas.ecg",
    "productName": "CardioAtlas ECG",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "CardioAtlas-ECG-${version}-Portable.exe"
    }
  }
}
